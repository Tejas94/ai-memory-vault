# Settings for the Node build (npm run start:node). Copy this file to ".env" and fill it in:
# the server reads .env when it starts. Never commit .env.
# The Cloudflare build doesn't use this file: its settings live in wrangler.jsonc and
# `wrangler secret put` (see docs/config.md).
# Lines starting with # are off. Each layer below has one choice to make.

# ---- 1. Database: one SQLite file (created on first start) ----
VAULT_DB=./vault.db
PORT=8788
# 127.0.0.1 = this computer only. Use 0.0.0.0 inside Docker or behind a reverse proxy.
HOST=127.0.0.1

# ---- 2. Who may connect: a secret key, a sign-in page, or both ----
# a) Secret key, for apps that can send a header (Claude Code and other MCP clients).
#    Make one with: openssl rand -hex 32
VAULT_KEY=

# b) Sign-in page, for Claude and ChatGPT on the web and phone. Needs a public https address.
#    Pick ONE sign-in service:
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=
#    ...or any OpenID Connect service (Microsoft, Auth0, Okta, Keycloak, Authentik):
#OIDC_ISSUER=https://login.example.com/realms/home
#OIDC_CLIENT_ID=
#OIDC_CLIENT_SECRET=
#    Needed with either service:
#ALLOWED_EMAIL=you@example.com
#COOKIE_ENCRYPTION_KEY=           # openssl rand -hex 32
#PUBLIC_URL=https://vault.example.com

# ---- 3. AI (optional): knowledge graph and meaning search ----
# Any OpenAI-style service. Free and private with Ollama on this computer:
#AI_BASE_URL=http://localhost:11434/v1
#AI_GRAPH_MODEL=llama3.1
#AI_EMBED_MODEL=bge-m3
# A hosted service instead (may cost money; it sees the text you save):
#AI_BASE_URL=https://api.openai.com/v1
#AI_API_KEY=
#AI_GRAPH_MODEL=gpt-4o-mini
#AI_EMBED_MODEL=text-embedding-3-small
# Fine-tuning for the embedding model (see docs/config.md):
#AI_EMBED_MIN_SCORE=0.45
#AI_EMBED_DIMENSIONS=
